# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini API Configuration
# Backend (nunca prefixe segredos com VITE_)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
REDIS_URL=redis://redis:6379
WEBHOOK_SHARED_SECRET=generate_a_long_random_secret
API_PORT=8080

# Evolution API: somente no worker/API, nunca no navegador
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE=your_instance_name
# Protect incoming Evolution webhooks and map them to the Horizons owner.
EVOLUTION_WEBHOOK_SECRET=generate_a_second_long_random_secret
HORIZONS_OWNER_USER_ID=your_supabase_auth_user_uuid

# BotBot API v2 e ponte de entrada para Typebot/Horizons.
BOTBOT_API_URL=https://botbot.chat
BOTBOT_AUTH_KEY=
BOTBOT_APP_KEY=
BOTBOT_WEBHOOK_TOKEN=generate_a_long_random_webhook_token
TYPEBOT_API_URL=
TYPEBOT_PUBLIC_ID=
TYPEBOT_API_TOKEN=
TYPEBOT_WORKSPACE_ID=
TYPEBOT_ID=
# Destinos de atendimento; o fluxo ativo de clientes é n8n.
N8N_SALES_PHONE=
N8N_SUPPORT_PHONE=
# Alias legado para pontes antigas; não usado pelo workflow n8n atual.
TYPEBOT_SALES_PHONE=
TYPEBOT_SUPPORT_PHONE=
TYPEBOT_FINANCE_PHONE=
TYPEBOT_GENERAL_PHONE=
# PaggPay: use sandbox durante a homologação. Nunca prefixe a chave com VITE_.
PAGGPAY_ENVIRONMENT=sandbox
PAGGPAY_API_KEY=
# Proteção adicional opcional para /webhooks/paggpay?token=...
PAGGPAY_WEBHOOK_TOKEN=
# URL tokenizada gerada pelo Union; segredo exclusivo do backend.
UNION_TEST_URL_DEFAULT=
# JSON protegido: chaves no formato servidor:horas:complete|no_adults.
CINEHUB_TEST_ENDPOINTS_JSON=

# IA via OmniRoute (API compatível com OpenAI). A chave e os modelos também podem
# ser definidos pelo painel em /configuracoes (gravados cifrados no banco); o
# painel tem prioridade sobre estas variáveis. Nunca exponha a chave no frontend.
OMNIROUTE_BASE_URL=http://host.docker.internal:20129/v1
OMNIROUTE_API_KEY=
# Modelos por tarefa (IDs exatamente como aparecem em GET /v1/models do OmniRoute)
AI_MODEL_FAST=
AI_MODEL_SMART=
AI_MODEL_VISION=
# Lista separada por vírgula, tentada em ordem quando o principal falha
AI_FALLBACK_MODELS=
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=1200

# Assistente administrativo: mantenha escritas e WhatsApp desligados até homologar.
ADMIN_ASSISTANT_WRITES_ENABLED=false
ADMIN_ASSISTANT_WHATSAPP_ENABLED=false
ADMIN_ASSISTANT_ALLOWED_PHONES=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_WEBHOOK_SECRET=
TELEGRAM_ADMIN_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_ENABLED=false
# Digest diário postado no Telegram do administrador (desligado por padrão).
HORIZONS_TELEGRAM_DAILY_DIGEST_ENABLED=false
HORIZONS_TELEGRAM_DAILY_DIGEST_CRON=0 8 * * *
# Lista de baixas confirmadas enviada por WhatsApp a partir do número
# financeiro (EVOLUTION_FINANCE_INSTANCE) para o número definido em
# HORIZONS_WHATSAPP_RENEWAL_NUMBER (desligado por padrão).
HORIZONS_WHATSAPP_RENEWAL_ENABLED=false
HORIZONS_WHATSAPP_RENEWAL_NUMBER=
HORIZONS_WHATSAPP_RENEWAL_LIST_CRON=0 */2 * * *
# Alerta financeiro no Telegram quando um comprovante entra em
# awaiting_bank_review (desligado por padrão).
HORIZONS_TELEGRAM_FINANCIAL_ALERTS_ENABLED=false
# Desativar delivery_profiles vencidos semanalmente (desligado por padrão).
HORIZONS_STALE_CATALOG_CHECK_ENABLED=false
HORIZONS_STALE_CATALOG_CHECK_CRON=0 3 * * 1
EVOLUTION_SALES_INSTANCE=Horizons Typebot
# Exact Evolution instance connected to the support number. Capture stays off
# until both values are deliberately configured.
EVOLUTION_SUPPORT_INSTANCE=
EVOLUTION_FINANCE_INSTANCE=
SUPPORT_CONVERSATION_CAPTURE_ENABLED=false

# Efí Bank Pix — configure apenas no .env da VPS, nunca no frontend ou Git.
# Os dois ambientes podem ficar configurados; EFI_ENVIRONMENT escolhe o ativo.
# Os certificados devem estar montados somente como leitura no container API.
EFI_ENVIRONMENT=homologation
EFI_HOMOLOGATION_CLIENT_ID=your_efi_homologation_client_id
EFI_HOMOLOGATION_CLIENT_SECRET=your_efi_homologation_client_secret
EFI_HOMOLOGATION_PIX_KEY=your_efi_homologation_pix_key
EFI_HOMOLOGATION_CERT_PATH=/run/certificados/homologacao-942044-horizon-codex.p12
EFI_PRODUCTION_CLIENT_ID=your_efi_production_client_id
EFI_PRODUCTION_CLIENT_SECRET=your_efi_production_client_secret
EFI_PRODUCTION_PIX_KEY=your_efi_production_pix_key
EFI_PRODUCTION_CERT_PATH=/run/certificados/producao-942044-horizon-codex.p12
# Token aleatório exclusivo para o callback. Necessário ao usar skip-mTLS.
EFI_WEBHOOK_TOKEN=generate_a_long_random_callback_token
# URL pública sem o token; usada apenas para o cadastro explícito do webhook.
EFI_WEBHOOK_URL=https://your-api-domain/webhooks/efi

# WPlay / wwpanel (painel com API propria; auth Bearer). Docs: https://docs.wplay.com.br
WWPANEL_API_URL=https://mcapi.knewcms.com:2087
WWPANEL_API_KEY=
WWPANEL_WRITES_ENABLED=false
WWPANEL_TESTS_ENABLED=false
WWPANEL_CUSTOMERS_ENABLED=false
WWPANEL_RENEWALS_ENABLED=false
WWPANEL_APP_ACTIVATION_ENABLED=false
# Janela (dias) de pagamento aceito na validação da Opção B (padrão 14)
WWPANEL_PAYMENT_WINDOW_DAYS=14

# Instâncias autorizadas a receber comprovantes (vazio bloqueia todas).
HORIZONS_RECEIPT_INSTANCES=Financeiro
